# ==============================================================================
# VERIFIN 2.0 — Backend Environment Configuration Example
# Copy this file to .env and adjust variables as needed for your environment.
# ==============================================================================

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=verifin

# Frontend & CORS
FRONTEND_URL=http://localhost:5173

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# Environment & Debugging
ENVIRONMENT=development
DEBUG=true

# Sign-in without a password (see docs/DEPLOY.md section 2e). Leave unset to turn each off.
# GOOGLE_CLIENT_ID=1234567890-abcdef.apps.googleusercontent.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM=you@gmail.com

# Storage
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=25

# ==============================================================================
# LLM Integration (Hugging Face Cloud Inference Providers)
# ==============================================================================
LLM_ENABLED=true
LLM_PROVIDER=huggingface
HF_TOKEN=your_huggingface_token
HF_MODEL=Qwen/Qwen2.5-72B-Instruct
HF_PROVIDER=auto
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=2048
LLM_MAX_INPUT_CHARS=30000
LLM_MAX_RETRIES=2

# Draft from document: how much is read and how many claims come back. More chunks or claims needs a longer budget and timeout;
# a local CPU model (Ollama) needs minutes, so set LLM_EXTRACTION_BUDGET_SECONDS around 300 there. Defaults shown.
# Measured on a 16-thread CPU: qwen2.5:3b about 11 tokens/s (115 s for 16 chunks and 8 claims); qwen2.5:7b about 5 tokens/s and did
# not finish within 480 s, so use 7b only with a GPU.
# Ollama only: its default context is 4096 tokens and silently cuts a longer prompt, and it unloads a model after 5 minutes idle.
# These two make the app call Ollama's native /api/chat (its OpenAI-compatible /v1 endpoint ignores them). Leave unset elsewhere.
# OLLAMA_NUM_CTX=8192
# OLLAMA_KEEP_ALIVE=30m
LLM_EXTRACTION_BUDGET_SECONDS=45
FACT_SAMPLE_MAX_CHUNKS=12
FACT_SAMPLE_MAX_PAGES=8
FACT_MAX_CLAIMS=10
FACT_FALLBACK_MAX_CLAIMS=8

