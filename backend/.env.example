# ==============================================================================
# VERIFIN 2.0 — Backend Environment Configuration Example
# Copy this file to .env and adjust variables as needed for your environment.
# ==============================================================================

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=verifin

# Frontend & CORS
FRONTEND_URL=http://localhost:5173

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# Environment & Debugging
ENVIRONMENT=development
DEBUG=true

# Storage
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=25

# ==============================================================================
# LLM Integration (Hugging Face Cloud Inference Providers)
# ==============================================================================
LLM_ENABLED=true
LLM_PROVIDER=huggingface
HF_TOKEN=your_huggingface_token
HF_MODEL=Qwen/Qwen2.5-72B-Instruct
HF_PROVIDER=auto
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=2048
LLM_MAX_INPUT_CHARS=30000
LLM_MAX_RETRIES=2

